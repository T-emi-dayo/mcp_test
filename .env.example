# Copy to .env and fill in real values. Never commit .env.

# ── Agent tokens (required) ───────────────────────────────────────────────────
# One bearer token per client. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AGENT_TOKEN_RESEARCH=
MCP_AGENT_TOKEN_ARISTOTLE=
MCP_AGENT_TOKEN_WANDER=
MCP_AGENT_TOKEN_CHALLENGE=
MCP_AGENT_TOKEN_ADMIN=

# ── Server (optional) ─────────────────────────────────────────────────────────
# PORT=10000

# ── Web search (optional; falls back to DuckDuckGo when unset) ────────────────
# GOOGLE_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=

# ── News search (optional; falls back to DuckDuckGo News when unset) ──────────
# NEWS_API_KEY=
